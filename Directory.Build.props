<Project>
  <PropertyGroup>
    <AutoPolicyVersion>0.1.0</AutoPolicyVersion>

    <Authors>Perry3D.nl</Authors>
    <Copyright>Copyright (c) 2026 Perry3D.nl</Copyright>
    <RepositoryUrl>https://github.com/Perry3Dnl/AutoPolicy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Perry3Dnl/AutoPolicy</PackageProjectUrl>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
