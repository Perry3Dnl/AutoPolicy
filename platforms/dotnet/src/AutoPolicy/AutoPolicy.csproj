<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AutoPolicy</RootNamespace>
    <AssemblyName>AutoPolicy</AssemblyName>
    <PackageId>AutoPolicy</PackageId>
    <Version>0.1.0</Version>
    <Description>Automatically turns ASP.NET Core Razor Pages into permission identities, then applies roles, groups, grants, and deny-wins overrides through the standard authorization pipeline.</Description>
    <PackageTags>aspnetcore;authorization;razorpages;permissions;policy</PackageTags>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
